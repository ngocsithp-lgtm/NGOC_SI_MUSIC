<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="ngoc_si_music.xml" />
        <include domain="sharedpref" path="ngocsi_music_drive_sources.xml" />
        <include domain="sharedpref" path="ngoc_si_music_playlists.xml" />
        <!-- Keep bulky offline Drive media out of the 25 MB cloud Auto Backup quota.
             Source links and playlists remain backed up and can be fetched again from Drive. -->
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="ngoc_si_music.xml" />
        <include domain="sharedpref" path="ngocsi_music_drive_sources.xml" />
        <include domain="sharedpref" path="ngoc_si_music_playlists.xml" />
        <include domain="file" path="drive_imports/" />
        <include domain="file" path="drive_artwork/" />
    </device-transfer>
</data-extraction-rules>