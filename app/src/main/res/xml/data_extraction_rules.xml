<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep normal app settings, playlists and queue. -->
        <include domain="sharedpref" path="ngoc_si_music.xml" />
        <!-- Drive sources/metadata are intentionally persistent across reinstall. -->
        <include domain="sharedpref" path="ngocsi_music_drive_sources.xml" />
        <!-- Audio files imported from Drive are needed to restore local playback. -->
        <include domain="file" path="drive_imports/" />
        <!-- OAuth tokens must never be restored from backup. -->
        <exclude domain="sharedpref" path="ngocsi_music_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="ngoc_si_music.xml" />
        <include domain="sharedpref" path="ngocsi_music_drive_sources.xml" />
        <include domain="file" path="drive_imports/" />
        <exclude domain="sharedpref" path="ngocsi_music_secure.xml" />
    </device-transfer>
</data-extraction-rules>
